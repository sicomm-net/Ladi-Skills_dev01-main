# Keep every text file in Unix (LF) line endings, matching Robin's +skills masters
* text=auto eol=lf

# Windows-only scripts keep Windows line endings
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Never touch binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  binary
*.tgz  binary
*.gz   binary